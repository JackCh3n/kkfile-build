# =============================================================================
# kkFileView 环境变量（systemd EnvironmentFile / Docker env-file 通用）
#
# 安装脚本会把它放到 /etc/kkfileview/kkfileview.env，systemd 通过
# EnvironmentFile= 读取。修改后执行：systemctl restart kkfileview
#
# 说明：application.properties 里全部配置项都写成 ${KK_XXX:默认值} 形式，
#       因此这里设置的环境变量会覆盖配置文件中的默认值。
# =============================================================================

# ---- JVM 参数（按空格分隔，无需引号） ----
JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC -Dfile.encoding=UTF-8

# ---- 服务端口与上下文路径 ----
KK_SERVER_PORT=8012
KK_CONTEXT_PATH=/

# ---- LibreOffice 安装路径 ----
# default = 自动在常见路径中查找（/usr/lib/libreoffice、/opt/libreofficeX.Y 等）
KK_OFFICE_HOME=default

# ---- 运行时数据目录（转换后的文件与本地预览文件，需要可写且空间充足） ----
KK_FILE_DIR=/var/lib/kkfileview/file
KK_LOCAL_PREVIEW_DIR=/var/lib/kkfileview/preview

# ---- 常用安全 / 行为开关（按需取消注释） ----
# KK_TRUST_HOST=127.0.0.1,192.168.1.0/24
# KK_NOT_TRUST_HOST=
# KK_FILE_UPLOAD_DISABLE=false
# KK_OFFICE_PREVIEW_TYPE=pdf
# KK_OFFICE_PREVIEW_SWITCH_DISABLED=true
# KK_MEDIA_CONVERT_DISABLE=false
